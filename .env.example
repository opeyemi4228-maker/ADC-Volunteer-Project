# Copy to .env.local and fill in. Nothing here is needed to run the demo locally.

# Public URL, used in SMS links (invite links, "sign in" prompts).
SITE_URL=http://localhost:3000

# Long random secret. Encrypts phone numbers and emails; keep it safe and never change it
# once real data exists. Generate with: openssl rand -base64 48
APP_SECRET=

# Database (PostgreSQL). Leave all three unset for local development: the site
# then uses an embedded Postgres in data/pglite and never touches live data.
# In production set APP_DATABASE_URL only: the limited account that
# `npm run db:setup` creates. DATABASE_URL (the owner) is for the admin
# scripts on your own machine, kept in .env.production, never on the host.
# APP_DATABASE_URL=postgresql://adc_app:...@...-pooler.../neondb?sslmode=verify-full
# DATABASE_URL=postgresql://neondb_owner:...@.../neondb?sslmode=require
# DATABASE_URL_POOLED=postgresql://neondb_owner:...@...-pooler.../neondb?sslmode=require
# DB_POOL_MAX=10

# Where uploads live (default data/uploads).
# STORAGE_DIR=/var/lib/adc/uploads

# Local development only: set to 1 to load synthetic demo data into an empty local database.
# Leave at 0 (the default) to start clean. Never set it to 1 for the live site.
SEED_DEMO=0

# One-time codes. "twilio_verify" (recommended): Twilio sends the code from its own
# pre-registered senders, so there is no Nigerian sender ID to register and DND
# numbers still receive it. "sms": we make the code and send it via SMS_PROVIDER.
# If Twilio Verify fails, codes fall back to SMS_PROVIDER automatically.
OTP_PROVIDER=sms
# Twilio account (twilio.com/console). An API key (SK...) may replace the auth token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# Verify service (Console -> Verify -> Services). Set code length 6, expiry 10 minutes.
TWILIO_VERIFY_SERVICE_SID=

# All other texts, and the fallback for codes. A comma list is tried in order,
# e.g. "africastalking,termii". Options: console | africastalking | twilio | termii.
# "console" displays OTPs on screen instead of sending SMS.
SMS_PROVIDER=console
# Africa's Talking (africastalking.com). Register the sender ID on the Nigerian
# transactional route so DND numbers receive it.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Twilio SMS (SMS_PROVIDER=twilio): a Messaging Service SID, or a sender.
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM=
# Termii (SMS_PROVIDER=termii). Sender ID must be approved in the Termii dashboard.
TERMII_API_KEY=
TERMII_SENDER_ID=
# TERMII_BASE_URL=https://v4.api.termii.com
# TERMII_CHANNEL=dnd

# USSD short code shown on the site, and a shared key for the aggregator callback URL.
NEXT_PUBLIC_USSD_CODE=
USSD_CALLBACK_KEY=

# WhatsApp Business Platform.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=

# Email (approval notices, password resets). Production requires SMTP_URL.
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
EMAIL_FROM="ADC Volunteers System <no-reply@adc.example>"

# Production file storage: private Cloudflare R2 bucket. Keep public access disabled.
# Local development defaults to local disk when STORAGE_BACKEND is unset.
# STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Vercel cron authentication. Generate separately from APP_SECRET.
CRON_SECRET=

# Google reCAPTCHA v3 (score-based) on registration, sign-in, phone-code and password-reset
# requests. The keys only work on the domains registered at google.com/recaptcha/admin,
# so leave both unset locally: the check is then skipped. The site key is public and
# is built into the page, so set it before `next build`.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Requests scoring below this (0.0 = bot, 1.0 = human) are refused. Default 0.5.
# RECAPTCHA_MIN_SCORE=0.5
