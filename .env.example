# Copy to .env.local and fill in. Nothing here is needed to run the demo locally.

# Public URL, used in SMS links (invite links, "sign in" prompts).
SITE_URL=http://localhost:3000

# Long random secret. Encrypts phone numbers and emails; keep it safe and never change it
# once real data exists. Generate with: openssl rand -base64 48
APP_SECRET=

# Database (PostgreSQL). Leave all three unset for local development: the site
# then uses an embedded Postgres in data/pglite and never touches live data.
# In production set APP_DATABASE_URL only: the limited account that
# `npm run db:setup` creates. DATABASE_URL (the owner) is for the admin
# scripts on your own machine, kept in .env.production, never on the host.
# APP_DATABASE_URL=postgresql://adc_app:...@...-pooler.../neondb?sslmode=verify-full
# DATABASE_URL=postgresql://neondb_owner:...@.../neondb?sslmode=require
# DATABASE_URL_POOLED=postgresql://neondb_owner:...@...-pooler.../neondb?sslmode=require
# DB_POOL_MAX=10

# Where uploads live (default data/uploads).
# STORAGE_DIR=/var/lib/adc/uploads

# Local development only: set to 1 to load synthetic demo data into an empty local database.
# Leave at 0 (the default) to start clean. Never set it to 1 for the live site.
SEED_DEMO=0

# SMS / WhatsApp sending. "console" logs messages instead of sending them.
SMS_PROVIDER=console

# USSD short code shown on the site, and a shared key for the aggregator callback URL.
NEXT_PUBLIC_USSD_CODE=
USSD_CALLBACK_KEY=

# WhatsApp Business Platform.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=

# Email (approval notices, password resets). Without SMTP_URL emails are logged, not sent.
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
EMAIL_FROM="ADC Volunteers System <no-reply@adc.example>"
