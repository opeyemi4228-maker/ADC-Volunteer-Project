# Copy to .env.local and fill in. Nothing here is needed to run the demo locally.

# Public URL, used in SMS links (invite links, "sign in" prompts).
SITE_URL=http://localhost:3000

# Long random secret. Encrypts phone numbers and emails; keep it safe and never change it
# once real data exists. Generate with: openssl rand -base64 48
APP_SECRET=

# Where the SQLite database and uploads live (defaults: data/adc.db, data/uploads).
# DATABASE_FILE=/var/lib/adc/adc.db
# STORAGE_DIR=/var/lib/adc/uploads

# Load demo data on first start (set to 0 for a real deployment).
SEED_DEMO=1

# SMS / WhatsApp sending. "console" logs messages instead of sending them.
SMS_PROVIDER=console

# USSD short code shown on the site, and a shared key for the aggregator callback URL.
NEXT_PUBLIC_USSD_CODE=*XXX*YY#
USSD_CALLBACK_KEY=

# WhatsApp Business Platform.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=

# Email (approval notices, password resets). Without SMTP_URL emails are logged, not sent.
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
EMAIL_FROM="ADC Volunteers System <no-reply@adc.example>"
